# SGR Financial Trading Agent - Environment Variables Configuration
# Copy this file to .env and fill in your actual API keys

# ============ Azure OpenAI Configuration ============
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=model-router
AZURE_OPENAI_REGION=eastus2
AZURE_OPENAI_RESOURCE_NAME=your-resource-name

# ============ Financial Data APIs ============
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
YAHOO_FINANCE_API_KEY=your_yahoo_finance_key
FRED_API_KEY=your_fred_api_key
NEWS_API_KEY=your_news_api_key
OPOINT_API_KEY=your_opoint_api_key

# ============ Trading Platforms ============
BINANCE_API_KEY=your_binance_key
BINANCE_SECRET_KEY=your_binance_secret
INTERACTIVE_BROKERS_API_KEY=your_ib_key

# ============ Prophet Arena (Forecasting Platform) ============
PROPHET_ARENA_API_KEY=your_prophet_arena_key

# ============ Risk Management Settings ============
MAX_POSITION_SIZE=0.05  # 5% max position size
MAX_DAILY_DRAWDOWN=0.02  # 2% max daily drawdown
ENABLE_PAPER_TRADING=true

# ============ Agent Configuration ============
MAX_SGR_STEPS=10
DEFAULT_FORECAST_HORIZON=1_week
RISK_TOLERANCE=medium

# ============ Data Configuration ============
REAL_TIME_ENABLED=false
DATA_RETENTION_DAYS=365
QUALITY_THRESHOLD=0.95

# ============ Performance Targets ============
TARGET_SHARPE_RATIO=2.0
MAX_DRAWDOWN_THRESHOLD=0.10
TARGET_BRIER_SCORE=0.09
